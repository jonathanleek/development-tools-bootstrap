{
  "extraKnownMarketplaces": {
    "astronomer": {
      "source": {
        "source": "github",
        "repo": "astronomer/agents"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "astronomer-data@astronomer": true
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "mcp__fusion__fusion_mcp_read",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(dscacheutil *)"
    ]
  }
}
