{
  "enabledPlugins": {
    "astronomer-data@astronomer": true
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "mcp__fusion__fusion_mcp_read",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(dscacheutil *)"
    ]
  }
}
