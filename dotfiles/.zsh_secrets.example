# Copy this file to ~/.zsh_secrets (which is gitignored) and fill in real values.
# It is sourced by ~/.zshrc. NEVER commit real secrets.
#
#   cp dotfiles/.zsh_secrets.example ~/.zsh_secrets
#   chmod 600 ~/.zsh_secrets
#
# Pull the actual values from Bitwarden, not from an old machine's dotfile.

# export ANTHROPIC_API_KEY="sk-ant-..."
# export OPENAI_API_KEY="sk-..."
# export GITHUB_TOKEN="ghp_..."
