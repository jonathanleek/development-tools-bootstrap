# ~/.zshrc — symlinked from development-tools-bootstrap/dotfiles/zshrc
# (scripts/dotfiles.sh). Edit here or through the link; commit in the repo.

# Powerlevel10k instant prompt. Keep near the top: anything that may ask for
# input (passwords, y/n) must go above this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh. No OMZ theme: the prompt is powerlevel10k, sourced below.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Prompt: powerlevel10k (homebrew/core), configured in ~/.p10k.zsh
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Start Claude Code under the mi6 config stack for the current folder.
# `mi6 --bare claude` (or `command claude`) starts it with plain ~/.claude.
alias claude='mi6 claude'
